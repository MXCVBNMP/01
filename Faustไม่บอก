-- Combined Fluent UI example (inserted features)
local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()
local SaveManager = loadstring(game:HttpGet("https://raw.githubusercontent.com/dawid-scripts/Fluent/master/Addons/SaveManager.lua"))()
local InterfaceManager = loadstring(game:HttpGet("https://raw.githubusercontent.com/dawid-scripts/Fluent/master/Addons/InterfaceManager.lua"))()

local Window = Fluent:CreateWindow({
    Title="Fluent Hub",
    SubTitle="Combined",
    TabWidth=160,
    Size=UDim2.fromOffset(580,460),
    Acrylic=true,
    Theme="Dark",
    MinimizeKey=Enum.KeyCode.LeftControl
})

local Tabs={
    Main=Window:AddTab({Title="Main"}),
    Settings=Window:AddTab({Title="Settings",Icon="settings"})
}

_G.AutoBuyBait=false
Tabs.Main:AddToggle("AutoBuyBait",{Title="Auto Buy Ancestral Bait",Default=false})
:OnChanged(function(v) _G.AutoBuyBait=v end)

task.spawn(function()
 local ev=game:GetService("ReplicatedStorage").Events.BuyBait
 while task.wait(0.1) do
  if _G.AutoBuyBait then ev:FireServer("Ancestral Bait") end
 end
end)

_G.AutoTicketQuest=false
Tabs.Main:AddToggle("AutoTicketQuest",{Title="Auto Ticket Quest",Default=false})
:OnChanged(function(v) _G.AutoTicketQuest=v end)

task.spawn(function()
 local E=game:GetService("ReplicatedStorage").Events.ChooseDialogueOption
 local NPC=workspace:WaitForChild("NPC"):WaitForChild("Function"):WaitForChild("Ticket Quest Giver")
 while task.wait(10) do
  if _G.AutoTicketQuest then
   E:FireServer("Ticket Quest Giver",1,"Quest",{NPC})
   E:FireServer("Ticket Quest Giver",2,"HardAcceptQuest",{NPC,"Ticket Quest"})
   E:FireServer("Ticket Quest Giver",1,"Quest",{NPC})
   E:FireServer("Ticket Quest Giver",2,"SBF",{NPC})
  end
 end
end)

_G.AutoBoss=false
Tabs.Main:AddToggle("AutoBoss",{Title="Auto Boss Phase 2",Default=false})
:OnChanged(function(v) _G.AutoBoss=v end)

task.spawn(function()
 local Event=game:GetService("ReplicatedStorage").Events.BossPhase2Action
 while task.wait() do
  if _G.AutoBoss then
   for i=1,10000 do
    if not _G.AutoBoss then break end
    Event:FireServer({Index=i,Hit=true})
    task.wait(0.1)
   end
  end
 end
end)

SaveManager:SetLibrary(Fluent)
InterfaceManager:SetLibrary(Fluent)
SaveManager:IgnoreThemeSettings()
InterfaceManager:SetFolder("FluentScriptHub")
SaveManager:SetFolder("FluentScriptHub/specific-game")
InterfaceManager:BuildInterfaceSection(Tabs.Settings)
SaveManager:BuildConfigSection(Tabs.Settings)
Window:SelectTab(1)
